[Unit]
Description=Tempus Fugit Word Clock
After=network.target

[Service]
ExecStart=/usr/bin/python3 -u /home/sar/TFWordclock/Wordclockr5.py -b 3 -u sar
Restart=on-failure
ExecStopPost=/usr/bin/python3 /home/sar/TFWordclock/Wordclockr5.py -c
Type=simple
StandardOutput=append:/var/log/tfword.log
StandardError=append:/var/log/tfword.log

[Install]
WantedBy=multi-user.target
